@model List<MvcBasicSample.Models.Product>
@{
    ViewData["Title"] = "商品一覧";
    int total = 0;

}
<h1>商品一覧</h1>   @*画面内の見出し*@
<ul>
    @foreach (var product in Model)
    {
        <li>@product.Name @product.Price 円</li>
    }
</ul>